# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv/
env/
venv/
ENV/

# Temporary logs and OS
*.log
.DS_Store
Thumbs.db
.env

# Test directories and Streamlit apps
test/
tests/
streamlit_app/
**/test/
**/tests/
**/streamlit_app/

# Explicitly KEEP trained models, metadata, reports, and notebooks for GitHub & Render deployment
!artifacts/
!artifacts/models/
!artifacts/models/*.joblib
!artifacts/*.json
!artifacts/reports/
!artifacts/plots/
!notebooks/
!notebooks/*.ipynb
