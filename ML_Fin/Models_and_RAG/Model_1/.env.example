# GramBiz Model 1 — Environment Configuration
# Copy this file to .env and customize values.

# Model paths
MODEL1_MODEL_PATH=models/model_1_final.joblib
MODEL1_METADATA_PATH=models/model_1_metadata.json
MODEL1_FEATURE_SCHEMA_PATH=models/feature_schema.json

# API configuration
MODEL1_HOST=0.0.0.0
MODEL1_PORT=8001
MODEL1_ENV=development

# Future deployment URL (do not hardcode in code)
# MODEL1_URL=https://your-model1-service.onrender.com

# Logging
LOG_LEVEL=INFO
