# ====================================================================
# GramBiz Model 1 — Git Ignore Configuration
# ====================================================================

# Environment & Virtualenvs
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment Secrets
.env
!.env.example

# Intermediate temporary files
*.tmp
*.log

# Test directories and Streamlit apps
test/
tests/
streamlit_app/
**/test/
**/tests/
**/streamlit_app/

# NOTE: models/ and notebooks/ are intentionally EXCLUDED from .gitignore
# so trained model artifacts (model_1_final.joblib, metadata, scalers)
# and Jupyter notebooks are pushed to GitHub for Render deployment.

